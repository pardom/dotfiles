# XDG Base Directory defaults, available before tool modules load.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export XDG_CONFIG_DIRS="${XDG_CONFIG_DIRS:-/etc/xdg}"
# XDG_RUNTIME_DIR requires session-managed lifetime and permissions; do not
# invent a persistent directory or substitute TMPDIR here.

# Use ~/.dotfiles unless DOTFILES_DIR is already set.
# (N) makes an unmatched pattern an empty list, so missing files are fine.
for module_file in "${DOTFILES_DIR:-$HOME/.dotfiles}"/modules/*/env.zsh(N); do
    source "$module_file"
done
unset module_file
